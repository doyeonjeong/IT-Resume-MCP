# Cloud LLM provider for the high-level resume/portfolio/cover-letter tools
# Choose: openai | claude | gemini
LLM_PROVIDER=gemini

# Cloud API keys (set the one(s) matching LLM_PROVIDER; fallback chain uses any present)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Local LLM backend for the stepwise pipeline
# (analyze_jd / match_profile_to_jd / generate_resume_bullets / generate_resume_markdown)
# Choose: ollama | openai-compatible
LOCAL_LLM_PROVIDER=ollama

# Generic local LLM settings (factory applies provider-specific defaults if these are unset)
# LOCAL_LLM_BASE_URL=http://localhost:11434         # default for ollama
# LOCAL_LLM_MODEL=gemma4:26b                         # default for ollama
# LOCAL_LLM_API_KEY=                                 # ollama: not used

# --- Preset: MLX on Apple Silicon (LOCAL_LLM_PROVIDER=openai-compatible) ---
# LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=mlx-community/gemma-4-26b-a4b-it-4bit
# LOCAL_LLM_API_KEY=mlx                              # MLX server does not validate; any non-empty value

# --- Preset: Hugging Face Router (LOCAL_LLM_PROVIDER=openai-compatible) ---
# LOCAL_LLM_BASE_URL=https://router.huggingface.co/v1
# LOCAL_LLM_MODEL=zai-org/GLM-5.1:preferred
# LOCAL_LLM_API_KEY=hf_your-token-here

LLM_TIMEOUT_MS=120000
