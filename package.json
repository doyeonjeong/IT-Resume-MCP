{
  "name": "@doyeonjeong/resume-mcp",
  "version": "0.1.1",
  "description": "Local-only MCP server that turns a job description into a tailored resume from your private profile. Profile data stays on your machine.",
  "author": "doyeonjeong",
  "license": "MIT",
  "homepage": "https://github.com/doyeonjeong/IT-Resume-MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doyeonjeong/IT-Resume-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/doyeonjeong/IT-Resume-MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "resume",
    "cover-letter",
    "job-description",
    "ats",
    "ollama",
    "local-llm",
    "claude",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "resume-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "data/profile.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build && chmod +x dist/mcp-server.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "mcp": "tsx src/mcp-server.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/mcp-server.js",
    "pack:test": "npm run build && npm pack && echo '\\n→ test the packed tarball with: npx -y ./'$(ls -1t doyeonjeong-resume-mcp-*.tgz | head -1)",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@google/genai": "^1.31.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@supabase/supabase-js": "^2.86.2",
    "@types/marked": "^5.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "marked": "^17.0.1",
    "openai": "^6.9.1",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/test-sequencer": "^30.2.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
