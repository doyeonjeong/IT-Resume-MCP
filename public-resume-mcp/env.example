# LLM Provider: openai, claude, gemini 중 선택 (Cloud fallback용)
LLM_PROVIDER=gemini

# Cloud API Keys (사용하는 Provider에 맞게 설정, 선택)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Stepwise LLM backend for analyze_jd / match_profile_to_jd / generate_resume_bullets / generate_resume_markdown
LOCAL_LLM_PROVIDER=ollama

# Ollama backend
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Hugging Face router backend
HF_TOKEN=your-huggingface-token-here
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=zai-org/GLM-5.1:preferred

LLM_TIMEOUT_MS=120000
